{
   "action": {
      "default_icon": {
         "128": "icons/128.png",
         "16": "icons/16.png",
         "48": "icons/48.png"
      },
      "default_popup": "popup.html",
      "default_title": "TDM Fast 嗅探"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "all_frames": true,
      "js": [ "content.js" ],
      "matches": [ "\u003Call_urls>" ],
      "run_at": "document_idle"
   } ],
   "description": "TDM Fast Download Manager 的浏览器助手：接管下载链接，嗅探网页视频/音频/文件，支持 YouTube、X、B站等主流平台。",
   "host_permissions": [ "\u003Call_urls>", "http://127.0.0.1:37651/*" ],
   "icons": {
      "128": "icons/128.png",
      "16": "icons/16.png",
      "48": "icons/48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "TDM Fast 资源嗅探",
   "permissions": [ "webRequest", "downloads", "contextMenus", "storage", "notifications", "tabs", "webNavigation" ],
   "version": "4.6.0",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "inject.js" ]
   } ]
}
